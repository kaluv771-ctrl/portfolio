*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    color: black;
    background-color:url(img8.jpg)center/cover no-repeat;
    /*transition: background-color 0.3s, color 0.3s;*/
}

a {
    text-decoration: none;
    color: inherit;
}

ul {
    list-style: none;
}


/* =========================================
   VARIABLES
========================================= */

:root {
    --primary: ;
    --primary-dark: #1d4ed8;

    --text: #222222;
    --text-light: #666666;

    --background: #ffffff;
    --background-alt: #f5f7fb;

    --card: #ffffff;
    --border: #dddddd;

    --shadow: 0 5px 20px rgba(0, 0, 0, 0.08);

    --max-width: 1100px;
}


/* =========================================
   DARK MODE
========================================= */

body.dark-mode {
    --text: #f1f5f9;
    --text-light: #cbd5e1;

    --background: #0f172a;
    --background-alt: #1e293b;

    --card: #1e293b;
    --border: #334155;

    --shadow: 0 5px 20px rgba(0, 0, 0, 0.3);

    background-color: var(--background);
    color: var(--text);
}


/* =========================================
   GENERAL
========================================= */

.container {
    width: 90%;
    max-width: var(--max-width);
    margin: 0 auto;
}

.section {
    padding: 90px 0;
}

.section-title {
    text-align: center;
    margin-bottom: 50px;
}

.section-title p {
    color: var(--primary);
    font-weight: bold;
    margin-bottom: 5px;
}

.section-title h2 {
    font-size: 2.2rem;
}

/* =========================================
   BUTTONS
========================================= */

.btn {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: bold;
    border: 2px solid transparent;
    transition: 0.3s;
    cursor: pointer;
}

.primary-btn {
    background-color: var(--primary);
    color: white;
}

.primary-btn:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
}

.secondary-btn {
    border-color: var(--primary);
    color: var(--primary);
}

.secondary-btn:hover {
    background-color: var(--primary);
    color: white;
}


/* =========================================
   HEADER
========================================= */

.header {
    position: sticky;
    top: 0;
    z-index: 1000;

    background-color: var(--background);
    border-bottom: 1px solid var(--border);
}

.navbar {
    height: 70px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 1.4rem;
    font-weight: bold;
    color: var(--primary);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 25px;
}

.nav-links a {
    font-weight: 500;
    transition: color 0.3s;
}

.nav-links a:hover {
    color: var(--primary);
}

.theme-btn {
    border: none;
    background: transparent;
    font-size: 1.3rem;
    cursor: pointer;
}

.menu-toggle {
    display: none;

    border: none;
    background: transparent;

    font-size: 1.8rem;
    cursor: pointer;

    color: var(--text);
}



.hero {
    min-height: calc(100vh - 70px);

    display: flex;
    align-items: center;

    background-color: var(--background-alt);
}

.hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 50px;
}

.intro {
    color: var(--primary);
    font-weight: bold;
    font-size: 1.1rem;
}

.hero h1 {
    font-size: 4rem;
    margin: 5px 0;
}

.hero h2 {
    color: var(--text-light);
    font-size: 1.5rem;
    margin-bottom: 20px;
}

.hero-text > p:not(.intro) {
    max-width: 550px;
    color: var(--text-light);
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.hero-image {
    display: flex;
    justify-content: center;
}

.profile-placeholder {
    width: 300px;
    height: 300px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background-color: var(--primary);
    color: white;

    font-size: 1.5rem;
    font-weight: bold;

    box-shadow: var(--shadow);
}


/* =========================================
   ABOUT
========================================= */

.about-content {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    align-items: center;
    gap: 60px;
}

.about-placeholder {
    width: 100%;
    height: 350px;

    display: flex;
    align-items: center;
    justify-content: center;

    background-color: var(--background-alt);
    border-radius: 10px;

    color: var(--text-light);
    font-size: 1.5rem;
}

.about-text h3 {
    font-size: 1.8rem;
    margin-bottom: 20px;
}

.about-text p {
    color: var(--text-light);
    margin-bottom: 20px;
}
.box img{
    width: 150%;
    height: 500px;
    object-fit:cover;
    border-radius: 6px;
    display: block;
}

/* =========================================
   SKILLS
========================================= */

.skills-section {
    background-color: var(--background-alt);
}

.skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.skill-card {
    padding: 30px 20px;

    background-color: var(--card);

    border: 1px solid var(--border);
    border-radius: 10px;

    text-align: center;

    box-shadow: var(--shadow);

    transition: transform 0.3s;
}

.skill-card:hover {
    transform: translateY(-5px);
}

.skill-icon {
    font-size: 2.5rem;
    margin-bottom: 15px;
}

.skill-card h3 {
    margin-bottom: 10px;
}

.skill-card p {
    color: var(--text-light);
}


/* =========================================
   PROJECTS
========================================= */

.projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.project-card {
    background-color: var(--card);

    border: 1px solid var(--border);
    border-radius: 10px;

    overflow: hidden;

    box-shadow: var(--shadow);

    transition: transform 0.3s;
}

.project-card:hover {
    transform: translateY(-5px);
}

.project-image {
    height: 180px;

    display: flex;
    align-items: center;
    justify-content: center;

    background-color: var(--primary);
    color: white;

    font-size: 1.5rem;
    font-weight: bold;
}

.project-content {
    padding: 25px;
}

.project-content h3 {
    margin-bottom: 10px;
}

.project-content p {
    color: var(--text-light);
    margin-bottom: 15px;
}

.project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;

    margin-bottom: 20px;
}

.project-tags span {
    padding: 5px 10px;

    background-color: var(--background-alt);
    color: var(--primary);

    border-radius: 20px;

    font-size: 0.8rem;
}

.project-link {
    color: var(--primary);
    font-weight: bold;
}


/* =========================================
   RESUME
========================================= */

.resume-section {
    padding: 60px 0;

    background-color: var(--primary);
    color: white;
}

.resume-content {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;
}

.resume-content p {
    opacity: 0.9;
}

.resume-content h2 {
    margin-top: 5px;
}

.resume-btn {
    background-color: white;
    color: var(--primary);
}

.resume-btn:hover {
    background-color: #f1f5f9;
}


/* =========================================
   CONTACT
========================================= */

.contact-content {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 60px;
}

.contact-info h3 {
    font-size: 1.8rem;
    margin-bottom: 15px;
}

.contact-info > p {
    color: var(--text-light);
    margin-bottom: 30px;
}

.contact-item {
    margin-bottom: 20px;
}

.contact-item p {
    color: var(--text-light);
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-group label {
    font-weight: bold;
}

.form-group input,
.form-group textarea {
    width: 100%;

    padding: 12px 15px;

    border: 1px solid var(--border);
    border-radius: 6px;

    background-color: var(--card);
    color: var(--text);

    font-family: inherit;
    font-size: 1rem;

    outline: none;
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: var(--primary);
}

.form-group textarea {
    resize: vertical;
}

#form-message {
    color: #16a34a;
    font-weight: bold;
}


/* =========================================
   FOOTER
========================================= */

.footer {
    padding: 30px 0;

    background-color: var(--background-alt);

    border-top: 1px solid var(--border);

    text-align: center;
}

.footer p {
    color: var(--text-light);
}

.social-links {
    margin-top: 10px;

    display: flex;
    justify-content: center;
    gap: 20px;
}

.social-links a {
    color: var(--primary);
}


/* =========================================
   TABLETS
========================================= */

@media (max-width: 900px) {

    .skills-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .projects-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero h1 {
        font-size: 3rem;
    }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 700px) {

    .menu-toggle {
        display: block;
    }

    .nav-links {
        position: absolute;

        top: 70px;
        left: 0;

        width: 100%;

        padding: 20px;

        flex-direction: column;
        align-items: flex-start;

        background-color: var(--background);

        border-bottom: 1px solid var(--border);

        display: none;
    }

    .nav-links.active {
        display: flex;
    }


    .hero {
        padding: 70px 0;
    }

    .hero-content {
        grid-template-columns: 1fr;

        text-align: center;
    }

    .hero-text > p:not(.intro) {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-image {
        order: -1;
    }

    .profile-placeholder {
        width: 220px;
        height: 220px;
    }


    .about-content {
        grid-template-columns: 1fr;
        gap: 30px;
    }


    .skills-grid {
        grid-template-columns: 1fr;
    }


    .projects-grid {
        grid-template-columns: 1fr;
    }


    .resume-content {
        flex-direction: column;
        text-align: center;
    }


    .contact-content {
        grid-template-columns: 1fr;
        gap: 40px;
    }


    .section {
        padding: 60px 0;
    }

    .section-title h2 {
        font-size: 1.8rem;
    }

}
